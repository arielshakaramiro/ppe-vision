# 1 = jalankan pipeline kamera saat server start (butuh bobot aktif models.ppe, default backend/weights/best.pt, dan sumber video)
RUN_PIPELINE=0
# 1 = proses otomatis job analisis rekaman dari proses API localhost/dev, tanpa menjalankan backup/retensi worker produksi.
# Nyalakan ini bila memakai upload video mode analisis tetapi tidak menjalankan `python -m scripts.worker`.
# ANALYSIS_JOB_RUNNER=0

# Sumber video (opsional, menimpa config.yaml): path file atau rtsp://user:pass@ip:554/stream1
# CAMERA_SOURCE=
# FPS target tampilan live MJPEG. Deteksi YOLO tetap berjalan adaptif sesuai kemampuan hardware.
# STREAM_TARGET_FPS=24
# Jumlah frame maksimum agar overlay deteksi lama masih boleh dianggap sinkron dengan frame terbaru.
# STREAM_OVERLAY_MAX_AGE_FRAMES=3
# 1 = isi jeda inferensi dengan frame mentah tanpa kotak lama; 0 = tampilkan hanya frame hasil inferensi.
# STREAM_DISPLAY_RAW_WHEN_STALE=1

# Admin awal (opsional). Dibuat saat start jika belum ada; hapus DASHBOARD_PASSWORD setelah akun jadi.
# Alternatif: python -m scripts.users add <nama> --role admin, atau halaman Pengguna dari komputer server.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# 1 jika dashboard diakses lewat HTTPS (cookie hanya dikirim lewat HTTPS)
COOKIE_SECURE=0
# Lama sesi login (jam)
# SESSION_HOURS=12
# Produksi di balik reverse proxy (deploy/docker-compose.prod.yml mengisi ini otomatis).
# Alamat proxy tepercaya, dipisah koma, boleh CIDR. Kosong = header X-Forwarded-For tidak pernah dipercaya.
# TRUSTED_PROXIES=127.0.0.1
# Domain untuk HTTPS (dipakai Caddy). localhost atau IP LAN = sertifikat internal Caddy.
# DOMAIN=k3.perusahaan.co.id
# Origin lain yang boleh mengirim request pengubah data (pisahkan koma). Kosong secara bawaan;
# dev server Vite tidak membutuhkannya.
# ALLOWED_ORIGINS=
# Mode produksi (1 = aktifkan validasi fail-fast & guard zona produksi; deploy/docker-compose.prod.yml mengisi ini otomatis)
# PRODUCTION=0

# Kunci tanda tangan riwayat chat agent (acak per proses jika kosong di dev; wajib >=16 karakter di produksi)
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
# AGENT_HISTORY_KEY=
# 1 = tampilkan dokumentasi API interaktif di /docs (hanya untuk development)
# API_DOCS=0
# Batas pertanyaan agent per menit per username + IP (0 = tanpa batas)
# AGENT_RATE_LIMIT=20

# Override upload untuk demo laptop dengan disk terbatas. Default produksi tetap dari backend/config.yaml:
# max 20 GiB, cadangan disk 10 GiB, potongan 10 MiB.
# UPLOAD_RESERVE_GB=1
# UPLOAD_MAX_GB=20
# UPLOAD_CHUNK_MB=10

# Agent, full lokal (bawaan): Ollama di komputer yang sama. Pasang Ollama lalu: ollama pull qwen2.5:7b
# Jika Ollama mati, agent otomatis menjawab dengan router offline (tanpa LLM).
# LLM_PROVIDER=ollama          # ollama | offline | anthropic (opsional, cloud, butuh API key + paket anthropic)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b      # RAM 8 GB: coba qwen2.5:3b
# OLLAMA_CONNECT_TIMEOUT_S=3
# OLLAMA_READ_TIMEOUT_S=35
# OLLAMA_MAX_STEPS=3
# OLLAMA_NUM_PREDICT=220
# OLLAMA_TEMPERATURE=0.1
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_NUM_CTX=4096
# Hanya jika LLM_PROVIDER=anthropic (cloud, tidak dipakai di mode full lokal):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Alert Telegram (opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ID thread / topic khusus untuk pengiriman alert foto CCTV (jika menggunakan Forum Topics grup)
# TELEGRAM_ALERT_THREAD_ID=
# User ID Telegram tambahan yang boleh menekan tombol review (pisahkan koma). Lebih disarankan: hubungkan
# ID Telegram ke akun di halaman Pengguna. Kosong dan belum ada akun terhubung = semua anggota chat (mode demo).
TELEGRAM_REVIEWER_IDS=
# 0 = matikan tombol review (long polling)
# TELEGRAM_POLLING=1

# Database (default SQLite di backend/data/ppe.db)
# DATABASE_URL=     (kosong = SQLite di backend/data/ppe.db)
# Postgres butuh paket driver tambahan (psycopg) yang belum ada di requirements.txt.

# Lanjutan
# PPE_CONFIG=config.prod.yaml      # path config lain, relatif ke folder backend/ (atau path absolut)
# MODEL_DEVICE=cpu                  # cpu | mps | cuda, menimpa models.device di config.yaml
# Kunci enkripsi rahasia untuk URL kamera (wajib jika menyimpan URL RTSP dengan password).
# Buat dengan: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CAMERA_SECRET_KEY=
